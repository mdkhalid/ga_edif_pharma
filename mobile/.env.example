# Base URL of the backend API, including the /api/v1 prefix.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so this must
# contain no secret.
#
#   - iOS simulator / web:  http://localhost:3001/api/v1
#   - Android emulator:     http://10.0.2.2:3001/api/v1   (localhost is the device)
#   - Physical device:      your machine's LAN address, e.g. http://192.168.1.20:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_APP_VERSION=0.1.0
