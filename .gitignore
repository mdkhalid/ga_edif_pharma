# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Expo / React Native
.expo/
.expo-shared/
mobile/android/
mobile/ios/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Environment — never commit real secrets
.env
.env.*
!.env.example
!.env.test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db

# Runtime / local data
tmp/
temp/
uploads/
*.pid
*.seed

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/.terraform.lock.hcl
# Variable files and plans routinely contain real cloud credentials / secrets
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log

# AI assistant / editor tool state — local working notes, not project source
.workbuddy-ai/
.cursor/
.claude/
.aider*
.commandcode/

# Local overrides that must never be shared
docker-compose.override.yml
docker-compose.*.local.yml
*.local.yml
*.local.yaml

# Local databases and dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Turbo / build caches
.turbo/
.eslintcache
.stylelintcache

# Package manager misc
.pnpm-debug.log
.npmrc.local
