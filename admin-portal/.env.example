# Base URL of the backend API, including the /api/v1 prefix.
# Browser-visible, so it must contain no secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Sent as X-App-Version; the server uses it for the force-upgrade check.
NEXT_PUBLIC_APP_VERSION=0.1.0
# Server-only. The BFF routes reach the API through this address, which in a
# deployed environment is usually an internal DNS name the browser cannot resolve.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
API_BASE_URL=http://localhost:3001/api/v1
