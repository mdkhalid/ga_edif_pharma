    "test:coverage": "jest --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "decimal.js": "10.4.3"
  },
  "devDependencies": {
    "@medichain/config": "*",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  }
}
