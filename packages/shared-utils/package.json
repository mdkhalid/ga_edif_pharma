{
  "name": "@medichain/shared-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Money arithmetic and salt normalisation shared by backend, web and mobile",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
