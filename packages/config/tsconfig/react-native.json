{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "MediChain React Native (Expo) application",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2023"],
    "jsx": "react-jsx",
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
