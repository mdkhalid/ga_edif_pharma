                "X",
                "NARCOTIC"
              ]
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "example": "name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated product list."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Browse products",
        "tags": [
          "catalog"
        ]
      }
