  "info": {
    "title": "MediChain API",
    "description": "Pharma distribution and ordering platform. Errors follow RFC 9457 (`application/problem+json`); collections are always paginated.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Registration, sign-in, token rotation and sessions"
    },
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "metrics",
      "description": "Prometheus metrics scrape endpoint"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "Email address. Either this or `phone` is required."
          },
          "phone": {
            "type": "string",
            "example": "+919876543210",
            "description": "E.164 phone number. Either this or `email` is required."
          },
          "fullName": {
            "type": "string",
            "example": "Priya Sharma",
            "minLength": 2,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "example": "a-long-and-memorable-passphrase",
            "minLength": 12,
            "maxLength": 128,
            "description": "At least 12 characters. A phrase of a few words is stronger and easier to remember than a short jumble of symbols."
          },
          "tenantCode": {
            "type": "string",
            "example": "SUNRISE",
            "description": "Code of the pharma company you are registering with. Required when the platform hosts more than one."
          }
        },
        "required": [
          "fullName",
          "password"
        ]
      },
      "VerifyContactRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "The email address or phone number to verify."
          }
        },
        "required": [
          "identifier"
        ]
      },
      "VerifyContactDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "The email address or phone number that was registered."
          },
          "code": {
            "type": "string",
            "example": "048392",
            "minLength": 6,
            "maxLength": 6,
            "description": "The six-digit code sent to the email address or phone number. Single-use, expires shortly, and capped after a few wrong attempts."
          }
        },
        "required": [
          "identifier",
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "Email address or phone number."
          },
          "password": {
            "type": "string",
            "example": "a-long-and-memorable-passphrase"
          },
          "deviceId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-...",
            "description": "Stable per-installation identifier, shown on the \"your devices\" screen."
          },
          "deviceLabel": {
            "type": "string",
            "example": "Chrome on Windows",
            "maxLength": 200
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued by the previous sign-in or refresh. Rotated on every use — store the new value returned by this call and discard the old one."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "The email address or phone number on the account. The response is the same whether or not an account exists."
          }
        },
        "required": [
          "identifier"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "buyer@sunrisepharma.in",
            "description": "The email address or phone number on the account."
          },
          "code": {
            "type": "string",
            "example": "048392",
            "minLength": 6,
            "maxLength": 6,
            "description": "The six-digit reset code."
          },
          "newPassword": {
            "type": "string",
            "example": "a-new-long-and-memorable-passphrase",
            "minLength": 12,
            "maxLength": 128,
            "description": "The new password, at least 12 characters. The same policy as registration applies, and every existing session is signed out."
          }
        },
        "required": [
          "identifier",
          "code",
          "newPassword"
        ]
      },
      "SubmitApplicationDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DISTRIBUTOR",
              "WHOLESALER",
              "PHARMACY",
              "HOSPITAL"
            ],
            "example": "DISTRIBUTOR"
          },
          "legalName": {
            "type": "string",
            "example": "Sunrise Pharma Distributors Pvt Ltd"
          },
          "tradeName": {
            "type": "string",
            "example": "Sunrise Pharma"
          },
          "drugLicenceNo": {
            "type": "string",
            "example": "DL-KA-2026-01234"
          },
          "gstin": {
            "type": "string",
            "example": "29ABCDE1234F1Z5"
          },
          "pan": {
            "type": "string",
            "example": "ABCDE1234F"
          },
          "stateCode": {
            "type": "string",
            "example": "29"
          },
          "email": {
            "type": "string",
            "example": "buyer@sunrisepharma.in"
          },
          "phone": {
            "type": "string",
            "example": "+919876543210"
          }
        },
        "required": [
          "type",
          "legalName"
        ]
      },
      "ReviewApplicationDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Licence verified against portal.",
            "maxLength": 500
          }
        }
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Paracetamol 650mg Strip of 15"
          },
          "description": {
            "type": "string",
            "example": "Fever and pain relief"
          },
          "schedule": {
            "type": "string",
            "example": "OTC",
            "enum": [
              "OTC",
              "H",
              "H1",
              "X",
              "NARCOTIC"
            ]
          },
          "hsnCode": {
            "type": "string",
            "example": "30049099"
          },
          "strength": {
            "type": "string",
            "example": "650mg"
          },
          "packSize": {
            "type": "number",
            "example": 15
          },
          "packUnit": {
            "type": "string",
            "example": "strip"
          },
          "price": {
            "type": "number",
            "example": 42.5
          },
          "saltAliases": {
            "example": [
              "Paracetamol"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compositionKey": {
            "type": "string",
            "example": "Paracetamol"
          }
        },
        "required": [
          "name",
          "schedule",
          "price"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Paracetamol 650mg Strip of 15"
          },
          "price": {
            "type": "number",
            "example": 45
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "ARCHIVED"
            ]
          }
        }
      },
      "AddItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "quantity": {
            "type": "number",
            "example": 10,
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "UpdateItemDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "example": 5,
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "quantity"
        ]
      },
      "PlaceOrderDto": {
        "type": "object",
        "properties": {
          "deliveryAddress": {
            "type": "string",
            "example": "14, Residency Road, Bengaluru 560025"
          },
          "notes": {
            "type": "string",
            "example": "Call before delivery",
            "maxLength": 500
          }
        }
      },
      "TransitionDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Verified over phone.",
            "maxLength": 500
          }
        }
      }
    }
  }
}
