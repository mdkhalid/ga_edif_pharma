// MediChain — Phase 0 schema: tenancy, identity, configuration, audit.
//
// Scope note: this file contains only what Phase 0 needs to run. The catalogue,
// salt engine, pricing, cart, orders, inventory, credit, payments, invoicing,
// logistics and returns models arrive with their own phases (see docs/05).
// Adding them here "for completeness" would mean maintaining tables that no code
// reads and that no test exercises.
//
// Conventions, applied without exception:
//   - snake_case in the database, camelCase in TypeScript, via @map / @@map.
//   - UUID primary keys generated by the database, so a row created by raw SQL
//     or a migration has the same shape as one created by the application.
//   - `tenant_id` on every tenant-owned table, from day one. Retrofitting a
//     tenant column onto a table that already holds production data means
//     backfilling with a guessed owner — which is how data ends up in the wrong
//     tenant permanently.
//   - Money is NUMERIC(18,4) and never a float. Binary floating point cannot
//     represent 0.1 exactly, so a ledger of DECIMAL money summed as float drifts.
//   - Timestamps are TIMESTAMPTZ. A naive timestamp in a system with warehouses
//     in more than one timezone is a bug waiting for a DST boundary.

// Phase 1 models (Core Commerce MVP) — added for Onboarding, Catalogue, Salt Engine, Cart and Orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Tenancy
// ===========================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgType {
  DISTRIBUTOR
  WHOLESALER
  PHARMACY
  HOSPITAL
}

enum OrganisationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

/// A tenant is one pharma company operating on the platform.
///
/// Deliberately a first-class table rather than a column on every row. The
/// platform is multi-tenant from the start: the same deployment serves several
/// pharma companies, and "which company owns this order?" must be answerable
/// without joining four tables.
model Tenant {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   String       @unique @db.VarChar(32)
  name   String       @db.VarChar(200)
  status TenantStatus @default(ACTIVE)

  /// Shown on invoices and used in notification templates.
  legalName   String? @map("legal_name") @db.VarChar(300)
  /// GSTIN of the pharma company itself — printed on every tax invoice.
  gstin       String? @db.VarChar(15)
  /// Two-letter state code; determines CGST+SGST vs IGST on an invoice.
  stateCode   String? @map("state_code") @db.VarChar(2)
  /// Decimal digits after the point. 2 for INR, 3 for KWD, 0 for JPY.
  currency    String  @default("INR") @db.VarChar(3)

  /// Contact details for transactional notifications.
  supportEmail String? @map("support_email") @db.VarChar(320)
  supportPhone String? @map("support_phone") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisations Organisation[]
  users         User[]
  roles         Role[]
  products      Product[]
  warehouseStocks WarehouseStock[]
  carts         Cart[]
  cartItems     CartItem[]
  customerOrders CustomerOrder[]
  orderItems    OrderItem[]
  orderStatusHistory OrderStatusHistory[]
  priceLists    PriceList[]

  @@map("tenant")
}

/// A buying or selling organisation inside a tenant.
///
/// A distributor, wholesaler, pharmacy or hospital that has registered to order.
/// Distinct from `Tenant`, which is the pharma company supplying them: a tenant
/// has many organisations, and every order is between two of them.
model Organisation {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String             @map("tenant_id") @db.Uuid
  type     OrgType
  status   OrganisationStatus @default(PENDING)

  legalName    String  @map("legal_name") @db.VarChar(300)
  tradeName    String? @map("trade_name") @db.VarChar(300)
  /// Drug licence number. Ordering scheduled medicines without a valid licence
  /// is a criminal offence, so this is required before an organisation activates.
  drugLicenceNo String? @map("drug_licence_no") @db.VarChar(64)
  /// 15-character GSTIN. Unique per tenant, not globally: two pharma companies
  /// may legitimately both sell to the same pharmacy.
  gstin        String? @db.VarChar(15)
  pan          String? @db.VarChar(10)
  stateCode    String? @map("state_code") @db.VarChar(2)

  email String? @db.VarChar(320)
  phone String? @db.VarChar(20)

  /// Default commercial terms. Overridden per order where needed.
  paymentTerms String  @default("ADVANCE") @map("payment_terms") @db.VarChar(16)
  creditLimit  Decimal @default(0) @map("credit_limit") @db.Decimal(18, 4)

  /// Denormalised for the tenant registry view. The authoritative ledger lives
  /// in the credit module; this is a cache of its balance, maintained inside the
  /// same transaction as every ledger write so it can never drift.
  currentExposure Decimal @default(0) @map("current_exposure") @db.Decimal(18, 4)

  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy String?   @map("approved_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users  User[]
  products Product[]
  carts Cart[]
  customerOrders CustomerOrder[]

  @@unique([tenantId, gstin])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@map("organisation")
}

// ===========================================================================
// Identity and access
// ===========================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ActorType {
  USER
  SYSTEM
  API_KEY
}

enum SessionRevokedReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  ADMIN_FORCED
  PASSWORD_CHANGED
  EXPIRED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  VERIFY_CONTACT
}

/// A person who signs in.
///
/// `tenantId` is nullable for exactly one case: the platform super-admin, who
/// operates across tenants and belongs to none. Every other user has a tenant.
model User {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String?    @map("tenant_id") @db.Uuid
  status   UserStatus @default(PENDING_VERIFICATION)

  /// Null for staff accounts that sign in by phone only.
  email String? @db.Citext
  /// E.164, so a number is unambiguous across countries.
  phone String? @db.VarChar(20)

  fullName String @map("full_name") @db.VarChar(200)

  /// Argon2id. Never a password, never a reversible hash, never logged.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// The organisation this user belongs to. Null for pharma-company staff.
  organisationId String? @map("organisation_id") @db.Uuid

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)

  /// Failed sign-in attempts since the last success. Reset on success.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set when the attempt count crosses the threshold. Checked before verifying
  /// the password, so a locked account cannot be probed at all.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)

  /// Forces every session to be re-established after a password change.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  /// AES-256-GCM envelope of the TOTP shared secret (AAD `user:<id>`).
  /// Null until enrolment starts; cleared when MFA is disabled.
  mfaSecret         String?   @map("mfa_secret") @db.VarChar(512)
  /// SHA-256 digests of unused recovery codes, canonical `XXXXX-XXXXX` form.
  /// Displayed exactly once at enrolment; consumed one at a time at sign-in.
  mfaRecoveryCodes  String[]  @default([]) @map("mfa_recovery_codes")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organisation Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  sessions     Session[]
  otpChallenges OtpChallenge[]

  /// Sign-in is by email OR phone, so neither is globally unique on its own.
  /// The uniqueness that matters is "one account per identifier per tenant", and
  /// that is enforced by the partial unique indexes in the migration — Prisma's
  /// schema language cannot express a partial index, so it is written in SQL
  /// where it can also exclude soft-deleted rows.
  @@index([tenantId, status])
  @@index([email])
  @@index([phone])
  @@map("user")
}

/// A named bundle of capabilities.
///
/// Roles are rows, not an enum, because every tenant reorganises its back office
/// differently. A tenant admin can create "Regional Manager" and grant it a
/// subset of capabilities without a deploy.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid
  code        String  @db.VarChar(64)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  /// System roles are seeded and cannot be renamed or deleted; they are
  /// referenced by the authorisation rules in code.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capabilities RoleCapability[]
  users        UserRole[]

  /// `tenantId` is nullable, so a plain `@@unique([tenantId, code])` would not
  /// constrain the seeded global roles (Postgres treats NULLs as distinct). The
  /// migration adds two partial unique indexes instead: one for tenant roles,
  /// one for global roles.
  @@index([tenantId, code])
  @@map("role")
}

/// Grants one capability to one role.
///
/// `capability` is a plain string validated in code against the `Capability`
/// map in @medichain/shared-types, rather than a foreign key to a capability
/// table. The enum is the source of truth and changes with a deploy; a mirrored
/// table would need a seed migration on every change and would drift the first
/// time someone forgot one. The trade-off is accepted deliberately: an invalid
/// capability string grants nothing, so the failure mode is a missing permission
/// (loud, in testing) rather than a spurious one (silent, in production).
model RoleCapability {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  capability String @db.VarChar(64)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, capability])
  @@map("role_capability")
}

model UserRole {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  /// Optional narrowing: an empty array means "all warehouses in the tenant".
  /// ABAC scoping lives here so a warehouse operator can be limited to one site
  /// without inventing a role per site.
  scopeWarehouses String[] @default([]) @map("scope_warehouses") @db.Uuid
  scopeRegions    String[] @default([]) @map("scope_regions") @db.VarChar(64)

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_role")
}

/// One signed-in device.
///
/// A session, not a token. Refresh tokens rotate on every use, so a user has one
/// session and many tokens over its lifetime. Revoking the session is what
/// "sign out everywhere" means, and it is also what happens automatically when
/// token reuse is detected.
model Session {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Stable per installation. Lets a user recognise "Chrome on Windows" and
  /// revoke it specifically.
  deviceId    String? @map("device_id") @db.VarChar(128)
  deviceLabel String? @map("device_label") @db.VarChar(200)
  ipAddress   String? @map("ip_address") @db.VarChar(45)
  userAgent   String? @map("user_agent") @db.VarChar(500)

  /// Groups every token descended from one sign-in. On reuse detection the whole
  /// family is revoked — the point is that an attacker who stole a token cannot
  /// keep using a freshly rotated one.
  familyId String @map("family_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Absolute expiry. A refresh cannot extend a session past this, so a stolen
  /// token cannot be renewed indefinitely.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  revokedAt     DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokedReason? @map("revoked_reason")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

/// One issued refresh token.
///
/// Stored as a SHA-256 digest, never the token itself. A database dump then
/// yields no usable credential: the digest cannot be reversed and the token has
/// 256 bits of entropy, so it cannot be guessed either.
///
/// `usedAt` is what makes reuse detection possible. A token presented with
/// `usedAt` already set has been replayed — either by an attacker or by a client
/// that lost a race — and the safe response is to revoke the entire family and
/// force a fresh sign-in.
model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised from the session.
  ///
  /// The row is looked up by `tokenHash` before the tenant is known — the access
  /// token has expired, so there is no principal and no tenant on the context.
  /// Carrying the tenant here anyway keeps the scoping rule uniform: *every*
  /// tenant-owned table is filtered by the extension, with no exception list to
  /// remember. The pre-authentication lookup runs inside an explicit
  /// `withoutTenantScope()` block, which is greppable and reviewable, rather
  /// than being implicitly unscoped forever because of how it is queried.
  tenantId  String @map("tenant_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  /// The token issued in place of this one. Lets an investigation walk the
  /// rotation chain when reuse is detected.
  replacedByTokenId String? @map("replaced_by_token_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId, expiresAt])
  @@map("refresh_token")
}

/// A one-time code sent by email or SMS.
///
/// The code is stored as a digest, and `attempts` is capped so a 6-digit code
/// cannot be brute-forced within its lifetime. `consumedAt` makes it single-use:
/// an OTP that stays valid after use is a permanent backdoor for anyone who
/// reads the user's inbox.
model OtpChallenge {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String?    @map("tenant_id") @db.Uuid
  purpose  OtpPurpose

  /// Email or phone the code was sent to, normalised.
  destination String @db.VarChar(320)
  codeHash    String @map("code_hash") @db.VarChar(64)

  attempts   Int       @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id") @db.Uuid

  @@index([destination, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenge")
}

// ===========================================================================
// Runtime configuration
// ===========================================================================

enum PlatformSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  /// Encrypted with AES-256-GCM before storage. Never returned by any API.
  SECRET
}

/// Layer 2 configuration: anything an operator changes without a redeploy.
///
/// This is what makes runtime AI-provider switching work (docs/13). An admin
/// pastes a new provider key; it is encrypted here and read at the point of use.
/// Nothing in this table is in the environment, so nothing here needs a deploy.
///
/// Deliberately global, not tenant-scoped: these are platform integration
/// credentials. Tenant-specific configuration belongs in a tenant-scoped table
/// so one tenant cannot read another's settings.
model PlatformSetting {
  id    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key   String              @unique @db.VarChar(160)
  type  PlatformSettingType @default(STRING)

  /// Plain value for non-secrets. Null when `type` is SECRET.
  value String? @db.Text

  /// Base64 AES-256-GCM envelope. Null for non-secrets. Never serialised to a
  /// response DTO — the admin API returns a fingerprint instead, so "did the key
  /// change?" is answerable without disclosing it.
  encryptedValue String? @map("encrypted_value") @db.Text

  /// Human-readable purpose, shown in the admin UI.
  description String? @db.VarChar(500)
  /// Grouping for the settings screen, e.g. `ai`, `payments`, `notifications`.
  category    String  @default("general") @db.VarChar(64)
  /// Marks a key that must be present before the app is considered configured.
  isRequired  Boolean @default(false) @map("is_required")

  /// Bumping this invalidates every cached read without touching the value.
  version Int @default(1)

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("platform_setting")
}

/// A feature flag with optional per-tenant override.
///
/// `tenantId` null means the platform default. A tenant row shadows it. Kept out
/// of `platform_setting` because flags are read on hot paths and evaluated per
/// request, so they need their own cache key and their own invalidation.
model FeatureFlag {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key      String  @db.VarChar(120)
  tenantId String? @map("tenant_id") @db.Uuid

  enabled Boolean @default(false)

  /// Percentage rollout, 0–100. Evaluated against a hash of the tenant id so a
  /// tenant's experience is stable across requests rather than flickering as it
  /// crosses the threshold.
  rolloutPercentage Int @default(0) @map("rollout_percentage")

  description String? @db.VarChar(500)

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Postgres treats NULLs as distinct, so this does not constrain the platform
  /// default rows. A partial unique index in the migration does.
  @@index([key, tenantId])
  @@map("feature_flag")
}

// ===========================================================================
// Audit and messaging
// ===========================================================================

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Append-only record of who did what.
///
/// Append-only in the strict sense: there is no update path and no delete path
/// in the application, and the migration grants the application role INSERT and
/// SELECT but not UPDATE or DELETE. An audit log the application can rewrite is
/// not evidence.
///
/// Written inside the same transaction as the change it describes. A row written
/// on a separate connection can survive a rolled-back mutation, or be lost when
/// a committed one succeeds — either makes the log untrustworthy.
model AuditLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Machine-readable, e.g. `order.approve`. Stable; the UI maps it to a label.
  action String @db.VarChar(120)
  /// Entity type, e.g. `Order`. Null for actions that are not about one entity.
  entity String? @db.VarChar(80)
  entityId String? @map("entity_id") @db.Uuid

  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email") @db.VarChar(320)
  actorRole  String?  @map("actor_role") @db.VarChar(64)

  outcome AuditOutcome @default(SUCCESS)

  /// Correlation id of the request. This is what ties an audit row to the log
  /// lines and traces of the request that produced it.
  correlationId String? @map("correlation_id") @db.VarChar(64)
  requestId     String? @map("request_id") @db.VarChar(64)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  /// Field-level change record: `{ "status": { "from": "PLACED", "to": "CONFIRMED" } }`.
  /// Never the full entity, and never a password, token or prescription payload —
  /// the log is widely readable and append-only, so it must not become a second
  /// copy of sensitive data.
  changes Json?

  /// Free-form context: the reason given, the approval reference, and so on.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, actorId, createdAt])
  @@index([correlationId])
  @@map("audit_log")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

/// Transactional outbox.
///
/// ## Why this exists
///
/// Publishing a domain event after committing a business change is a
/// dual-write: the commit succeeds and the publish fails, or the publish
/// succeeds and the transaction rolls back. Either way the system's state and
/// its events disagree, and there is no way to tell which is correct.
///
/// The outbox removes the dual write. The event row is inserted *inside* the
/// same transaction as the change, so it exists if and only if the change
/// committed. A relay then publishes it afterwards. Delivery becomes
/// at-least-once, which is why every consumer must be idempotent — keyed by
/// `id`, which is stable across redeliveries.
model OutboxEvent {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable: some platform events are not tenant-owned.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Dotted event name, e.g. `order.placed`. Consumers subscribe by prefix.
  eventType String @map("event_type") @db.VarChar(120)
  /// Partition key. Events for one aggregate must be processed in order, so the
  /// relay orders by this rather than by insertion time.
  aggregateType String @map("aggregate_type") @db.VarChar(80)
  aggregateId   String @map("aggregate_id") @db.Uuid

  payload Json

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(10) @map("max_attempts")
  /// Set when `status` becomes PROCESSING, so a crashed relay does not leave a
  /// row stuck forever. The relay reclaims rows whose lock has gone stale.
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?      @map("locked_by") @db.VarChar(120)
  lastError   String?      @map("last_error") @db.Text
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)

  /// Lets a producer collapse duplicates — a replayed command with the same key
  /// inserts nothing new.
  deduplicationKey String? @map("deduplication_key") @db.VarChar(160)

  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([deduplicationKey])
  /// The relay's claim query: oldest available row that is not yet published.
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_event")
}

// ===========================================================================
// Phase 1 — Core Commerce MVP
// ===========================================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  CATALOGUE_ONLY
}

/// A medicine/product in the catalogue.
/// Controlled by schedule (H, H1, X, OTC). Every product belongs to a tenant
/// and is visible only within that tenant's catalogue.
model Product {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  organisationId String?           @map("organisation_id") @db.Uuid
  name           String            @db.VarChar(300)
  description    String?           @db.Text
  // OTC|H|H1|X|NARCOTIC
  schedule       String            @db.VarChar(10)
  hsnCode        String?           @map("hsn_code") @db.VarChar(16)
  strength       String?           @db.VarChar(50)
  packSize       Decimal           @default(0) @map("pack_size") @db.Decimal(18, 4)
  // e.g. strip, bottle, cap
  packUnit       String?           @map("pack_unit") @db.VarChar(20)
  price          Decimal           @default(0) @map("price") @db.Decimal(18, 4)
  currency       String            @default("INR") @db.VarChar(3)
  status         ProductStatus     @default(ACTIVE)
  visibility     ProductVisibility @default(PUBLIC)

  // Aliases / salt variations that this product maps to.
  saltAliases String[] @default([]) @map("salt_aliases")
  // Composition key + ingredient names.
  compositionKey   String?  @map("composition_key") @db.Text
  compositionNames String[] @default([]) @map("composition_names")

  warehouseStock WarehouseStock[]
  cartItems CartItem[]
  orderItems OrderItem[]

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, schedule])
  @@index([tenantId, status])
  @@map("product")
}

/// Warehouse stock level for a product.
model WarehouseStock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.VarChar(100)
  quantity    Decimal   @default(0) @map("quantity") @db.Decimal(18, 4)
  batchId     String?   @map("batch_id") @db.VarChar(64)
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  reserved    Decimal   @default(0) @map("reserved") @db.Decimal(18, 4)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId, productId])
  @@map("warehouse_stock")
}

/// A customer shopping cart. ACTIVE, ABANDONED, CONVERTED.
model Cart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  status         String   @default("ACTIVE") @db.VarChar(20)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  items CartItem[]

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("cart")
}

/// A cart item line. Price is snapshot at time of add.
/// Carries its own `tenant_id` per the project convention: the scoping
/// extension injects a tenant filter into every query on a scoped model, so a
/// line item without the column could not be classified as scoped.
model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @default(0) @map("quantity") @db.Decimal(18, 4)
  price     Decimal @default(0) @map("price") @db.Decimal(18, 4)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_item")
}

/// A placed order. Status: PLACED, CONFIRMED, DISPATCHED, DELIVERED, CANCELLED.
/// Payment: PENDING, PAID, FAILED, REFUNDED.
model CustomerOrder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  status         String   @default("PLACED") @db.VarChar(20)
  paymentStatus  String   @default("PENDING") @map("payment_status") @db.VarChar(20)
  subtotal       Decimal  @default(0) @map("subtotal") @db.Decimal(18, 4)
  discount       Decimal  @default(0) @map("discount") @db.Decimal(18, 4)
  total          Decimal  @default(0) @map("total") @db.Decimal(18, 4)
  currency       String   @default("INR") @db.VarChar(3)
  deliveryAddress String? @map("delivery_address") @db.Text
  notes           String? @db.Text
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledReason String?   @map("cancelled_reason") @db.VarChar(200)

  orderItems OrderItem[]
  statusHistory OrderStatusHistory[]

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("customer_order")
}

/// An order item line. Price is snapshot at order time.
/// Carries its own `tenant_id` — see CartItem.
model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @default(0) @map("quantity") @db.Decimal(18, 4)
  price     Decimal @default(0) @map("price") @db.Decimal(18, 4)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_item")
}

/// One recorded order status change. Append-only.
///
/// The Phase 1 exit criterion is that *every* transition appears here with an
/// actor, so placement writes the opening row (`fromStatus` null → `PLACED`)
/// and each state-machine move appends one. The row is written inside the same
/// transaction as the status change it describes: a history entry that can
/// survive a rolled-back transition, or be lost when one commits, is not
/// evidence that the transition happened.
///
/// `actorId` is non-null on purpose. A system-initiated transition must
/// therefore decide whose identity it acts under rather than writing a row
/// that cannot answer "who did this?".
model OrderStatusHistory {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  orderId  String @map("order_id") @db.Uuid

  /// Null only on the row written at placement — there is no previous status.
  fromStatus String? @map("from_status") @db.VarChar(30)
  toStatus   String  @map("to_status") @db.VarChar(30)

  /// The user who caused the change. Matches the actor on the audit row for
  /// the same action, so the two can be correlated.
  actorId String  @map("actor_id") @db.Uuid
  reason  String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order  CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The read is always "this order's history, oldest first".
  @@index([tenantId, orderId, createdAt])
  @@map("order_status_history")
}

// ===========================================================================
// End Phase 1 models
// ===========================================================================

// ===========================================================================
// Phase 2 — Commercial Engine: pricing persistence
//
// Price lists carry per-product override prices, optionally tiered by quantity
// (a higher `min_qty` line wins for larger orders). A buying organisation (the
// customer) is linked to one effective price list, and may additionally carry
// direct per-product overrides that beat the list. Everything is tenant-scoped
// and carries effective dating so a price list is only consulted inside its
// window. The resolver that turns these rows into a per-product override map is
// a pure function (see `price-override-resolver.ts`); the Prisma adapter only
// queries and maps.
// ===========================================================================

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// A named, tenant-scoped catalogue of per-product prices with an effective window.
model PriceList {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  name          String          @db.VarChar(200)
  status        PriceListStatus @default(DRAFT)
  effectiveFrom DateTime        @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime        @map("effective_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines    PriceListLine[]
  customers CustomerPriceList[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("price_list")
}

/// One product's override price within a list. `min_qty` makes it a quantity
/// tier: for a given line the resolver picks the highest `min_qty` that the
/// quantity meets, so bulk buyers automatically get the better tier.
model PriceListLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  priceListId String  @map("price_list_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  /// Minimum line quantity for this tier price to apply.
  minQty      Int     @map("min_qty") @default(1)
  /// Exact per-unit override price in the tenant's currency.
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQty])
  @@index([tenantId, productId])
  @@map("price_list_line")
}

/// Links a buying organisation to one price list.
model CustomerPriceList {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  organisationId String  @map("organisation_id") @db.Uuid
  priceListId    String  @map("price_list_id") @db.Uuid

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, organisationId])
  @@index([tenantId, priceListId])
  @@map("customer_price_list")
}

/// A direct, per-customer, per-product override. Beats the assigned price list.
model CustomerPriceOverride {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  organisationId String  @map("organisation_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 4)

  @@unique([tenantId, organisationId, productId])
  @@index([tenantId, organisationId])
  @@map("customer_price_override")
}
