# ============================================================================
# MediChain Backend — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Anything marked [RUNTIME] can also be changed at runtime through the admin
# portal (encrypted, stored in `platform_setting`). The env value is only the
# bootstrap default used on a cold database.
# ============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_NAME=MediChain
PUBLIC_BASE_URL=http://localhost:3001

# ---------- Database ----------
DATABASE_URL=postgresql://medichain:medichain@localhost:5432/medichain?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Never enable in production — migrations only.
DATABASE_SYNCHRONIZE=false

# ---------- Redis (cache / rate limit / queue / sessions) ----------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=medichain:

# ---------- Search ----------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
# When false the search module falls back to PostgreSQL FTS + pg_trgm.
SEARCH_USE_OPENSEARCH=true

# ---------- Object storage ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=medichain-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-me-with-32-plus-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-another-32-plus-random-chars
JWT_REFRESH_TTL=30d
# 32-byte base64 key. Used for AES-256-GCM column encryption (secrets at rest).
ENCRYPTION_KEY=replace-me-32-byte-base64-key=
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
# One-time codes for contact verification and password reset.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# DEV ONLY. Returns one-time codes in the API response body, so the verification
# and reset flows are driveable without an email/SMS transport (Phase 1 wires the
# real ones). The env schema refuses to boot with this true in production — it is
# an account takeover for anyone who can read a response or a log. Keep it false
# anywhere responses or logs are retained.
AUTH_EXPOSE_OTP_IN_RESPONSE=false

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SEARCH_MAX=120

# ---------- CORS ----------
# Comma separated. NEVER use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ---------- Notifications ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MediChain <no-reply@medichain.local>"
SMS_PROVIDER=console          # console | msg91 | twilio
SMS_API_KEY=
WHATSAPP_PROVIDER=none        # none | cloud-api
WHATSAPP_TOKEN=

# ---------- Payment gateways ----------
PAYMENT_DEFAULT_PROVIDER=mock  # mock | razorpay | stripe | payu
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- AI / ML providers [RUNTIME] ----------
# The bootstrap provider only. Admins can add/switch providers and rotate keys
# live from Admin → Settings → AI Providers, with no redeploy.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=openai     # openai | anthropic | azure-openai | bedrock | ollama | custom
AI_DEFAULT_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD=200
AI_FEATURES__PRESCRIPTION_OCR=false
AI_FEATURES__SEMANTIC_SEARCH=false
AI_FEATURES__DEMAND_FORECAST=false
AI_FEATURES__DESCRIPTION_ENRICH=false

# ---------- Observability ----------
LOG_LEVEL=debug               # trace|debug|info|warn|error
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ---------- Feature flags [RUNTIME] ----------
FF_MOBILE_APP_ENABLED=true
FF_ONLINE_PAYMENTS_ENABLED=false
FF_CREDIT_ORDERS_ENABLED=true
FF_MULTI_WAREHOUSE=false
FF_SALT_SMART_SUGGEST=true

# ---------- Seeding (development / CI only) ----------
# Leave unset to have a random password generated and printed once by `db:seed`.
# Set it to a known value when a test harness must sign in as a seeded account —
# a CI job cannot read a password printed to a log. Ignored in production, where
# the user seed refuses to run.
# SEED_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_EMAIL=root@medichain.local
# SEED_TENANT_ADMIN_EMAIL=admin@sunrisepharma.local
